# ---------------------------------------------------------------------------
# ERIL environment configuration (API / worker processes)
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=3001
API_GLOBAL_PREFIX=api
APP_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eril
DB_SSL=false
# Set to "true" only in local dev. Production must use migrations.
DB_SYNCHRONIZE=false

# Redis (optional in Phase 1 - background workers arrive in Phase 4)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL=60m
EMAIL_VERIFICATION_TTL=24h
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Throttling (requests per window)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Email provider (Phase 5) - leave blank to disable outbound email
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@eril.local

# Logging
LOG_LEVEL=info

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=/api/v1
