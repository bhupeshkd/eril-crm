# Backend-only environment template (root .env.example covers the full app).
# Copy to .env and adjust.
NODE_ENV=development
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
APP_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eril
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL=60m
EMAIL_VERIFICATION_TTL=24h
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@eril.local
LOG_LEVEL=info
SENDGRID_API_KEY=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
API_PUBLIC_URL=http://localhost:3001

# Community images: "database" (default) or "s3". With s3, new uploads go to the bucket;
# run `npm run images:to-s3` once to move images already stored in the database.
IMAGE_STORAGE=database
# S3 or S3-compatible storage (AWS, Cloudflare R2, DigitalOcean Spaces, MinIO)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for R2/Spaces/MinIO, e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ENDPOINT=
# true = bucket in the path (MinIO, most custom endpoints). Default: true with S3_ENDPOINT, false for AWS
S3_FORCE_PATH_STYLE=
S3_PREFIX=community-images/
# redirect (default): browsers load from S3 via short-lived links. proxy: the API streams the bytes.
S3_SERVE=redirect

# Web Push (optional): generate with `npx web-push generate-vapid-keys`. Unset = a key pair is generated once and kept in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
